<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Elmish.Avalonia.Glue.Testing</PackageId>
    <PackageMaturity>Experimental</PackageMaturity>
    <Description>Headless Avalonia helpers for Elmish host tests.</Description>
    <PackageTags>fsharp elmish avalonia testing</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Headless.fs" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.0" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.0" />
    <ProjectReference Include="..\Elmish.Avalonia.Glue\Elmish.Avalonia.Glue.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
