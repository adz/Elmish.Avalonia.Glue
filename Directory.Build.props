<Project>
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>

    <!-- Local/dev default only; the release workflow stamps the real version via -p:Version from the release tag. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Shared package metadata for the libraries under src/. Tests, tools and samples are never packed. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <Authors>Adam Davies</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://adz.github.io/Elmish.Avalonia.Glue/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/adz/Elmish.Avalonia.Glue</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);FS3390</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
